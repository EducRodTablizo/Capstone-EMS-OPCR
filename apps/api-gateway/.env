# =============================================================================
# API Gateway — Development Environment
# =============================================================================

PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ems_db
DB_USER=ems_user
DB_PASSWORD=ems_pass
DATABASE_URL=postgresql://ems_user:ems_pass@127.0.0.1:5433/ems_db
# ─── Dev Auth Mode ───────────────────────────────────────────────────────────
# Set to true to bypass JWT validation and inject the dev user below.
# Remove or set to false in production.
DEV_AUTH_MODE=true

# Dev user — must match UUIDs in database/04_seed.sql
# Change to any seeded user to test different roles.
DEV_USER_ID=11000000-0000-0000-0000-000000000001
DEV_USER_NAME=Maria Santos
DEV_USER_EMAIL=msantos@pup.edu.ph
DEV_USER_ROLE=subsystem_admin
DEV_OFFICE_ID=00000000-0000-0000-0000-000000000001
DEV_OFFICE_CODE=ADMIN_OFFICE
DEV_OFFICE_NAME=Administrative Office

# ─── Downstream Services ─────────────────────────────────────────────────────
IDENTITY_SVC_URL=http://localhost:3002
TRANSACTION_SVC_URL=http://localhost:3003
AUDIT_SVC_URL=http://localhost:3006
TIME_SVC_URL=http://localhost:3004
DASHBOARD_SVC_URL=http://localhost:3007

# ─── ARMS JWT (Production only — not used in DEV_AUTH_MODE) ─────────────────
# ARMS_JWT_SECRET=change_me_in_production
# ARMS_BASE_URL=http://arms.pup.edu.ph/api

# ─── PSS (optional) ──────────────────────────────────────────────────────────
# PSS_SLA_CALLBACK_SECRET=change_me_in_production
