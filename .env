# ─── Legacy / Generic ────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=ems_identity
DB_USER=ems_user
DB_PASSWORD=ems_pass

# Fallback (not used directly; each service has its own URL below)
DATABASE_URL=postgresql://ems_user:ems_pass@127.0.0.1:5434/ems_identity

# ─── Per-Service Database URLs (local dev) ───────────────────────────────────
# Each maps to the individually exposed host port for that service's container.
IDENTITY_DATABASE_URL=postgresql://ems_user:ems_pass@127.0.0.1:5434/ems_identity
TRANSACTION_DATABASE_URL=postgresql://ems_user:ems_pass@127.0.0.1:5435/ems_transaction
TIME_DATABASE_URL=postgresql://ems_user:ems_pass@127.0.0.1:5436/ems_time_tracking
AUDIT_DATABASE_URL=postgresql://ems_user:ems_pass@127.0.0.1:5437/ems_audit_log
DASHBOARD_DATABASE_URL=postgresql://ems_user:ems_pass@127.0.0.1:5438/ems_dashboard

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=ems_jwt_secret_capstone_2026
ARMS_JWT_SECRET=ems_jwt_secret_capstone_2026
JWT_EXPIRES_IN=8h

# ─── Inter-Service URLs (local dev — services talk to each other via localhost) ─
IDENTITY_SERVICE_URL=http://localhost:3002
TRANSACTION_SERVICE_URL=http://localhost:3003
TIME_SLA_SERVICE_URL=http://localhost:3004
AUDIT_SERVICE_URL=http://localhost:3006
DASHBOARD_SERVICE_URL=http://localhost:3007

# ─── API Gateway ─────────────────────────────────────────────────────────────
EMS_GATEWAY_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5175

# ─── PSS (External — not yet connected in Phases 1-3) ────────────────────────
PSS_BASE_URL=http://pss.pup.edu.ph/api
PSS_API_KEY=